# ── App ─────────────────────────────────────────────────────────────────────
APP_NAME=plauda
ENV=dev
APP_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=1440

# ── Database (Supabase Postgres) ────────────────────────────────────────────
# Supabase Dashboard → Project Settings → Database → Connection string → "Connection pooling".
# Paste it as-is (postgresql://...); the app converts it to postgresql+asyncpg:// automatically
# and handles SSL + Supavisor statement caching. Session mode (port 5432) is recommended.
DATABASE_URL=
# Optional: dedicated database for DB-backed pytest runs (tests skip when unset).
TEST_DATABASE_URL=

# ── CORS (JSON list) ────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173"]

# ── Embeddings (Phase 1) ────────────────────────────────────────────────────
EMBEDDING_PROVIDER=ollama_local
CF_ACCOUNT_ID=
CF_API_TOKEN=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ── Agent LLM (Phase 2) ─────────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_AGENT_MODEL=llama-3.3-70b-versatile
GROQ_CHEAP_MODEL=llama-3.1-8b-instant

# ── PayPal (Phase 4) ────────────────────────────────────────────────────────
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Fernet key for encrypting merchant PayPal credentials at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=
